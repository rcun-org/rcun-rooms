// Prisma Schema for RCUN Rooms Microservice (M4)
// Database: PostgreSQL (Neon) - can share DB with rcun-auth, different tables

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("ROOMS_DATABASE_URL")
}

// ROOMS_DATABASE_URL can be same as AUTH_DATABASE_URL for shared Neon DB
// e.g. ROOMS_DATABASE_URL=${AUTH_DATABASE_URL}

// ============================================
// Room Model (from rcun-server-node/backend/room/room.model.js)
// ============================================
model Room {
  id                   String   @id @default(uuid()) @db.Uuid
  title                String   @db.VarChar(48)
  ownerId              String   @map("owner_id") @db.Uuid // External User ID from rcun-auth
  backupVideo          String   @default("") @map("backup_video") @db.Text
  backupVideoTimestamp Float    @default(0) @map("backup_video_timestamp")
  backupPlayerState    Json     @default("{\"mode\":\"youtube\",\"url\":\"\",\"status\":\"paused\"}") @map("backup_player_state") @db.JsonB
  backupChatHistory    String   @default("{}") @map("backup_chat_history") @db.Text
  accessMode           String   @default("public") @map("access_mode") @db.VarChar(20)
  lifecycleStatus      String   @default("ready") @map("lifecycle_status") @db.VarChar(20)
  shareHash            String   @unique @map("share_hash") @db.VarChar(64)
  passwordDigest       String   @default("") @map("password_digest") @db.VarChar(64)
  draftExpiresAt       DateTime? @map("draft_expires_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  members    RoomMember[]
  messages   RoomMessage[]
  queueItems RoomQueueItem[]
  shareLinks RoomShareLink[]

  @@map("rooms")
}

// ============================================
// RoomMember Model (for invite functionality)
// ============================================
model RoomMember {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid // External User ID from rcun-auth
  role      String   @default("member") @db.VarChar(20) // owner, moderator, member
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("room_members")
}

model RoomMessage {
  id         String   @id @default(uuid()) @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid // External User ID from rcun-auth
  authorName String   @map("author_name") @db.VarChar(50)
  text       String   @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("room_messages")
}

model RoomShareLink {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @map("room_id") @db.Uuid
  hash      String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("room_share_links")
}

model RoomQueueItem {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  title       String   @db.VarChar(160)
  videoUrl    String   @map("video_url") @db.Text
  poster      String   @default("") @db.Text
  kind        String   @default("Long") @db.VarChar(32)
  duration    String   @default("Queued") @db.VarChar(64)
  position    Int
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, position])
  @@map("room_queue_items")
}
